# --- Daytona (required) -----------------------------------------------------
# https://app.daytona.io -> Keys
DAYTONA_API_KEY=dtn_xxxxxxxxxxxxxxxxxxxxxxxx
DAYTONA_API_URL=https://app.daytona.io/api
# Must be a region your organization is entitled to. `us` 403s with
# "Region us is not available to the organization" on some accounts - try `eu`.
DAYTONA_TARGET=eu

# --- Anthropic --------------------------------------------------------------
# Two independent uses:
#   1. The agent-under-test, if the scenario runs Claude Code.
#   2. The failure classifier, which clusters logs into failure modes. This
#      runs on the host, not in a sandbox, and degrades to heuristic labels
#      if the key is absent - so a non-Claude comparison run still gets a
#      report card, just a blunter one.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Only for identity-linked keys. If requests fail with "anthropic-workspace-id
# is required when authenticating with an identity-linked API key", set this to
# the workspace id (Console -> Settings -> Workspaces, looks like wrkspc_...).
# Leave blank for an ordinary key.
ANTHROPIC_WORKSPACE_ID=

# --- Agent-under-test providers ---------------------------------------------
# Whichever of these are set is forwarded into every sandbox. Which one you
# need is decided by `model` in the scenario JSON, written provider-first:
# `openrouter/qwen/qwen3-coder` needs OPENROUTER_API_KEY, and so on.
#
# The Aider and goose scenarios both default to openrouter/qwen/qwen3-coder,
# so the two report cards differ by agent and nothing else.
OPENROUTER_API_KEY=
# FREE TIER: 20 requests/minute, 50/day under $10 of credit (1000/day above
# it). The scarce resource is *requests*, not dollars - and one trial is many
# requests, because every agent turn is a call. Run `npm run budget` before a
# run to see how many trials today's remaining allowance actually buys.
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=

# --- Run defaults -----------------------------------------------------------
# How many sandboxes to keep in flight at once. This is capped by your
# Daytona tier, NOT by what your laptop can drive: this account allows 10
# concurrent sandboxes ("Total CPU limit exceeded. Maximum allowed: 10").
# Set it a little below the cap so a finishing sandbox has time to release
# its slot. Check yours at https://app.daytona.io/dashboard/limits
# On a free model tier, this is bounded by requests/minute, not by Daytona:
# 8 agents in flight breach 20/min almost immediately. Use 2.
RELIABILITY_CONCURRENCY=2
# Hard ceiling per trial, in seconds. Kills the sandbox and marks it timeout.
RELIABILITY_TRIAL_TIMEOUT=420

# --- Demo safety net --------------------------------------------------------
# MOCK=1 runs the whole pipeline against a simulated backend: no Daytona calls,
# no API spend, same UI, same timing shape. Use it to rehearse the demo and as
# the fallback if conference wifi dies.
MOCK=0

# The production server listens on this port. Most container platforms inject
# PORT automatically; the Docker image defaults to 3000 when it is unset.
PORT=3000
