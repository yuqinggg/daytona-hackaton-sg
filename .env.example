# --- Daytona (required) -----------------------------------------------------
# https://app.daytona.io -> Keys
DAYTONA_API_KEY=dtn_xxxxxxxxxxxxxxxxxxxxxxxx
DAYTONA_API_URL=https://app.daytona.io/api
# Must be a region your organization is entitled to. `us` 403s with
# "Region us is not available to the organization" on some accounts - try `eu`.
DAYTONA_TARGET=eu

# --- Anthropic (required) ---------------------------------------------------
# Used twice: the agent-under-test runs with this key inside each sandbox,
# and the classifier uses it to cluster failure logs into failure modes.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Only for identity-linked keys. If requests fail with "anthropic-workspace-id
# is required when authenticating with an identity-linked API key", set this to
# the workspace id (Console -> Settings -> Workspaces, looks like wrkspc_...).
# Leave blank for an ordinary key.
ANTHROPIC_WORKSPACE_ID=

# --- Run defaults -----------------------------------------------------------
# How many sandboxes to keep in flight at once. This is capped by your
# Daytona tier, NOT by what your laptop can drive: this account allows 10
# concurrent sandboxes ("Total CPU limit exceeded. Maximum allowed: 10").
# Set it a little below the cap so a finishing sandbox has time to release
# its slot. Check yours at https://app.daytona.io/dashboard/limits
RELIABILITY_CONCURRENCY=8
# Hard ceiling per trial, in seconds. Kills the sandbox and marks it timeout.
RELIABILITY_TRIAL_TIMEOUT=420

# --- Demo safety net --------------------------------------------------------
# MOCK=1 runs the whole pipeline against a simulated backend: no Daytona calls,
# no API spend, same UI, same timing shape. Use it to rehearse the demo and as
# the fallback if conference wifi dies.
MOCK=0
